apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: sample-app
  namespace: argocd
spec:
  project: orbit-projects
  source:
    repoURL: https://github.com/ORG/REPLACE_WITH_GITOPS_REPO.git
    targetRevision: main
    path: examples/microservices
  destination:
    server: https://kubernetes.default.svc
    namespace: sample-learning-platform
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
