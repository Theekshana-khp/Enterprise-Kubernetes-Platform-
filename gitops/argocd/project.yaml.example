apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: orbit-projects
  namespace: argocd
spec:
  sourceRepos:
    - https://github.com/ORG/REPLACE_WITH_GITOPS_REPO.git
  destinations:
    - namespace: '*'
      server: https://kubernetes.default.svc
  clusterResourceWhitelist:
    - group: ''
      kind: Namespace
